localBranchName=$(git rev-parse --abbrev-ref HEAD)
validBranchRegex="^(production|develop|phase\/[0-9]+-[a-z0-9-]+|(feat|fix|docs|style|refactor|chore)\/[a-z0-9-]+)$"

# Ignorar si estamos en un estado de 'detached HEAD'
if [ "$localBranchName" = "HEAD" ]; then
    exit 0
fi

if ! echo "$localBranchName" | grep -Eq "$validBranchRegex"; then
    echo " Error: Nombre de rama inválido '$localBranchName'"
    echo "Los nombres de las ramas deben seguir la estrategia Kanban del proyecto:"
    echo "  - Ramas base: production, develop"
    echo "  - Ramas de fase: phase/<numero>-<nombre> (ejemplo: phase/01-core-database)"
    echo "  - Ramas de trabajo: <type>/<module>-<desc>-<ticket_id> (ejemplo: feat/core-tenant-model-3)"
    exit 1
fi